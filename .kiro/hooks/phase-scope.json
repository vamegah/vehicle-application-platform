{
  "version": "v1",
  "hooks": [
    {
      "name": "phase-scope",
      "description": "Block writes to Phase 2-4 bounded contexts, outside the repository, to .git/, or to .env files",
      "trigger": "PreToolUse",
      "enabled": true,
      "timeout": 30,
      "matcher": "fs_write|str_replace|fs_append|smart_relocate|delete_file",
      "action": {
        "type": "command",
        "command": "powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File .kiro/hooks/scripts/check-phase-scope.ps1"
      }
    }
  ]
}
